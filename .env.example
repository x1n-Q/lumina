# Vercel test setup
# Add these three keys under Project Settings -> Environment Variables.
# Replace every placeholder and enable Production, Preview, and Development.
# Never commit the real values to this public repository.
LUMINA_USERNAME=replace-with-your-test-username
LUMINA_PASSWORD=replace-with-a-long-unique-test-password
LUMINA_SESSION_SECRET=replace-with-at-least-32-random-characters

# Generate a secure session secret:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Optional: an HTTPS-compatible Lumina backend for full web playback.
# Without this, the mobile web version intentionally uses playable previews.
# VITE_BACKEND_URL=https://your-compatible-backend.example.com
