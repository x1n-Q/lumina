LUMINA_USERNAME=your-private-username
LUMINA_PASSWORD=use-a-long-unique-password
LUMINA_SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional: an HTTPS-compatible Lumina backend for full web playback.
# Without this, the mobile web version intentionally uses playable previews.
# VITE_BACKEND_URL=https://your-compatible-backend.example.com
