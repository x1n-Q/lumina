{
  "name": "lumina",
  "productName": "Lumina",
  "desktopName": "Lumina",
  "description": "A polished desktop music player with live discovery and persistent offline audio caching.",
  "author": {
    "name": "x1n-Q",
    "email": "248301001+x1n-Q@users.noreply.github.com"
  },
  "homepage": "https://github.com/x1n-Q/lumina",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron": "NODE_ENV=development electron .",
    "start": "electron .",
    "lint": "oxlint",
    "preview": "vite preview",
    "generate:logo": "node scripts/generate-logo-assets.cjs",
    "prepare:runtime": "node scripts/prepare-yt-dlp.cjs",
    "dist:linux": "npm run build && npm run prepare:runtime -- --linux && electron-builder --linux deb AppImage --x64",
    "dist:win": "npm run build && npm run prepare:runtime -- --win && electron-builder --win nsis portable --x64",
    "dist:desktop": "npm run build && npm run prepare:runtime && electron-builder --linux deb AppImage --win nsis portable --x64"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lucide-react": "^1.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.2.0",
    "electron-builder": "26.15.3",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1"
  },
  "build": {
    "appId": "com.x1nq.lumina",
    "productName": "Lumina",
    "asar": true,
    "compression": "normal",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/lumina-logo.png",
      "server.cjs",
      "package.json",
      "!**/*.map",
      "!**/test*.cjs"
    ],
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "icon": "public/lumina-logo.png",
      "category": "AudioVideo",
      "executableName": "lumina",
      "syncDesktopName": true,
      "synopsis": "Lumina desktop music player",
      "description": "Discover, stream, and cache music locally with Lumina.",
      "extraResources": [
        {
          "from": "build-resources/bin/linux/yt-dlp",
          "to": "bin/yt-dlp"
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/lumina-logo.png",
      "executableName": "Lumina",
      "extraResources": [
        {
          "from": "build-resources/bin/win/yt-dlp.exe",
          "to": "bin/yt-dlp.exe"
        }
      ]
    },
    "nsis": {
      "artifactName": "Lumina-Setup-${version}-win-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Lumina",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Lumina-${version}-win-${arch}-portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "x1n-Q",
        "repo": "lumina"
      }
    ]
  }
}
